# local.properties.template
# 
# This is a template file for local.properties configuration.
# Copy this file to local.properties and fill in your values.
# DO NOT commit local.properties to version control.
#
# local.properties is added to .gitignore by default

# Android SDK Location (Required)
# Point to your Android SDK installation directory
sdk.dir=/path/to/android/sdk

# Supabase Configuration (Required)
# Get these values from your Supabase project dashboard
supabase.url=https://your-project.supabase.co
supabase.anon.key=your-anon-key-here
supabase.service.role.key=your-service-role-key-here

# Optional: Build Configuration
# Enable or disable certain features
enable.proguard=true
enable.crash.reporting=false

# Optional: API Endpoints
# Customize API endpoints if needed
api.timeout.seconds=30
